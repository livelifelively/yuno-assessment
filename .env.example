# --- LLM providers ---
# Gemini is the default provider (ADR-007). Required for any agent run.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback providers. Configurable per-agent.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Channels (batch 6) ---
# Telegram Bot token. Get from @BotFather. Leave blank until batch 6.
TELEGRAM_BOT_TOKEN=

# --- Database ---
# Read by both the backend container and Alembic.
POSTGRES_USER=yuno
POSTGRES_PASSWORD=yuno
POSTGRES_DB=yuno
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://yuno:yuno@postgres:5432/yuno

# --- App ---
APP_ENV=dev
LOG_LEVEL=info
